{{ 'section-quest-facebook-feed.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign fb_url = section.settings.page_url | default: settings.social_facebook_link | default: 'https://www.facebook.com/QuestWS'
-%}
<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="quest-fb page-width section-{{ section.id }}-padding" aria-labelledby="QuestFb-{{ section.id }}">
    <div class="quest-fb__intro">
      <h2 id="QuestFb-{{ section.id }}" class="{{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      <a class="button button--secondary" href="{{ fb_url }}" target="_blank" rel="noopener">
        {{- section.settings.button_label | escape -}}<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>
    <div class="quest-fb__frame" style="--fb-height: {{ section.settings.height }}px;">
      <iframe
        src="https://www.facebook.com/plugins/page.php?href={{ fb_url | url_encode }}&tabs=timeline&width=500&height={{ section.settings.height }}&small_header=true&adapt_container_width=true&hide_cover=false&show_facepile=false"
        title="{{ section.settings.heading | escape }} on Facebook"
        loading="lazy"
        width="500"
        height="{{ section.settings.height }}"
        allow="encrypted-media"
      ></iframe>
    </div>
  </section>
</div>

{%- style -%}
  .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px; padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px; }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding { padding-top: {{ section.settings.padding_top }}px; padding-bottom: {{ section.settings.padding_bottom }}px; }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Facebook feed",
  "tag": "div",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Follow Along on Facebook" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" } ], "default": "h2" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals, boat club news, demo days and life on the water in Starved Rock Country.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Visit us on Facebook" },
    { "type": "url", "id": "page_url", "label": "Facebook page URL", "info": "Defaults to the Facebook link in theme settings." },
    { "type": "range", "id": "height", "min": 400, "max": 800, "step": 50, "unit": "px", "label": "Feed height", "default": 600 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-2" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "presets": [ { "name": "Facebook feed" } ]
}
{% endschema %}
