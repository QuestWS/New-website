<div class="quest-utility" role="region" aria-label="Store contact">
  <div class="quest-utility__inner page-width" {{ section.shopify_attributes }}>
    <div class="quest-utility__group">
      <a href="{{ section.settings.address_link }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-6.2 7-12a7 7 0 1 0-14 0c0 5.8 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span class="quest-utility__long">{{ section.settings.address_text }}</span>
        <span class="quest-utility__short">{{ section.settings.directions_short }}</span>
      </a>
    </div>
    <div class="quest-utility__group">
      <a href="tel:{{ section.settings.phone_link | strip | replace: ' ', '' }}">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></svg>
        <span class="quest-utility__long">{{ section.settings.phone_text }}</span>
        <span class="quest-utility__short">{{ section.settings.call_short }}</span>
      </a>
      {%- if section.settings.hours_link != blank -%}
        <a class="quest-utility__hide-mobile" href="{{ section.settings.hours_link }}">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
          {{ section.settings.hours_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Quest utility bar",
  "tag": "section",
  "class": "quest-utility-section",
  "settings": [
    { "type": "text", "id": "address_text", "label": "Address text", "default": "1851 N 2871st Rd, Ottawa, IL" },
    { "type": "url", "id": "address_link", "label": "Address link (directions)", "default": "https://www.google.com/maps/dir/?api=1&destination=Quest+Watersports,+1800+N+2871st+Rd,+Ottawa,+IL+61350" },
    { "type": "text", "id": "directions_short", "label": "Mobile label for address", "default": "Directions" },
    { "type": "text", "id": "phone_text", "label": "Phone text", "default": "815.433.2200" },
    { "type": "text", "id": "phone_link", "label": "Phone number for tap-to-call", "default": "+18154332200" },
    { "type": "text", "id": "call_short", "label": "Mobile label for phone", "default": "Call" },
    { "type": "text", "id": "hours_text", "label": "Hours link text", "default": "Hours" },
    { "type": "url", "id": "hours_link", "label": "Hours link", "default": "/pages/contact" }
  ]
}
{% endschema %}
