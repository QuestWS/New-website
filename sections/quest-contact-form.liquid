{{ 'section-quest-contact-form.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- assign topics = 'Sales - Boats|Sales - Kayaks & Paddleboards|Sales - Sailboats|Sales - eBikes|Quest Express Boat Club|Service & Parts|Storage|Rentals|Sell or Trade|Employment|Other' | split: '|' -%}
{%- assign default_topic = section.settings.default_topic -%}
<div class="quest-form-wrap">
  <section class="quest-form qo-container section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="quest-form__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="quest-form__intro rte">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'contact', id: 'QuestContactForm', class: 'quest-form__form' -%}
      {%- if form.posted_successfully? -%}
        <div class="quest-form__success form-status" role="status" tabindex="-1" autofocus>
          <h3 class="form-status__title h4">Thanks for contacting us. We will get back to you as soon as possible.</h3>
        </div>
      {%- endif -%}
      {%- if form.errors -%}
        <div class="quest-form__errors form__message" role="alert" tabindex="-1" autofocus>
          <h3 class="form-status__title h4">Please fix the following</h3>
          <ul class="quest-form__error-list">
            {%- for field in form.errors -%}
              <li>{%- if field == 'form' -%}{{ form.errors.messages[field] }}{%- else -%}<a href="#QuestContactForm-{{ field }}">{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</a>{%- endif -%}</li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}

      <div class="quest-form__field">
        <label for="QuestContactForm-name">Name</label>
        <input id="QuestContactForm-name" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}" required>
      </div>
      <div class="quest-form__field">
        <label for="QuestContactForm-email">Email</label>
        <input id="QuestContactForm-email" type="email" name="contact[email]" autocomplete="email" inputmode="email" spellcheck="false" value="{{ form.email }}" required{% if form.errors contains 'email' %} aria-invalid="true"{% endif %}>
      </div>
      <div class="quest-form__field">
        <label for="QuestContactForm-phone">Phone</label>
        <input id="QuestContactForm-phone" type="tel" name="contact[phone]" autocomplete="tel" inputmode="tel" pattern="[0-9\-+()\s.]*" value="{{ form.phone }}">
      </div>
      <div class="quest-form__field">
        <label for="QuestContactForm-topic">What can we help you with?</label>
        <select id="QuestContactForm-topic" name="contact[Topic]">
          {%- for topic in topics -%}
            {%- assign topic_value = topic | replace: ' - ', ' – ' -%}
            <option value="{{ topic_value | escape }}"{% if topic_value == default_topic or topic == default_topic %} selected{% endif %}>{{ topic_value | escape }}</option>
          {%- endfor -%}
        </select>
      </div>
      <div class="quest-form__field">
        <label for="QuestContactForm-body">Message</label>
        <textarea id="QuestContactForm-body" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="quest-form__submit">{{ section.settings.button_label | default: 'Send message' | escape }}</button>
    {%- endform -%}
  </section>
</div>

{% schema %}
{
  "name": "Quest contact form",
  "tag": "section",
  "class": "section-quest-form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Send Us a Message" },
    { "type": "richtext", "id": "text", "label": "Intro text" },
    {
      "type": "select",
      "id": "default_topic",
      "label": "Preselected topic",
      "options": [
        { "value": "Sales – Boats", "label": "Sales – Boats" },
        { "value": "Sales – Kayaks & Paddleboards", "label": "Sales – Kayaks & Paddleboards" },
        { "value": "Sales – Sailboats", "label": "Sales – Sailboats" },
        { "value": "Sales – eBikes", "label": "Sales – eBikes" },
        { "value": "Quest Express Boat Club", "label": "Quest Express Boat Club" },
        { "value": "Service & Parts", "label": "Service & Parts" },
        { "value": "Storage", "label": "Storage" },
        { "value": "Rentals", "label": "Rentals" },
        { "value": "Sell or Trade", "label": "Sell or Trade" },
        { "value": "Employment", "label": "Employment" },
        { "value": "Other", "label": "Other" }
      ],
      "default": "Sales – Boats"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send message" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 36 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 36 }
  ],
  "presets": [ { "name": "Quest contact form" } ]
}
{% endschema %}
