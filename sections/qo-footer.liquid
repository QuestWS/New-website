{%- comment -%}
  Quest Watersports footer: map panel + contact form, "We are open" season tabs, bottom bar.
  Hours are edited per season in the "Season" blocks. Hours column format (one per line):
  "Label|Value" renders a label + blue value; a line without a pipe renders as a plain white note.
{%- endcomment -%}
{{ 'qo-footer.css' | asset_url | stylesheet_tag }}

{%- assign directions = section.settings.directions_url | default: 'https://www.google.com/maps/dir/?api=1&destination=Quest+Watersports,+1800+N+2871st+Rd,+Ottawa,+IL+61350' -%}
{%- assign phone_display = section.settings.phone_display | default: '815.433.2200' -%}
{%- assign phone_tel = section.settings.phone_tel | default: '+18154332200' | replace: ' ', '' -%}

<footer class="qo-footer" data-qo-footer {{ section.shopify_attributes }}>
  <div class="qo-footer__wrap">

    <div class="qo-footer__panel" style="--qo-footer-map: url('{{ 'qo-footer-back.webp' | asset_url }}')">
      <div class="qo-footer__map">
        <div class="qo-footer__dir">
          <img src="{{ 'qo-footer-pin.svg' | asset_url }}" alt="" width="29" height="42" loading="lazy">
          <a class="qo-footer__dir-link" href="{{ directions }}" target="_blank" rel="noopener">{{ section.settings.directions_label | default: 'Get Directions' }}<span class="visually-hidden"> (opens Google Maps)</span></a>
        </div>
        <address class="qo-footer__address">
          <p>{{ section.settings.address_line1 | default: '1851 Old Chicago Rd' }}<br>{{ section.settings.address_line2 | default: 'Ottawa, IL 61350' }}</p>
          <p>Phone: <a href="tel:{{ phone_tel }}">{{ phone_display }}</a></p>
          <p class="qo-footer__map-link"><a href="https://www.google.com/maps/search/?api=1&query=Quest+Watersports,+1800+N+2871st+Rd,+Ottawa,+IL+61350" target="_blank" rel="noopener">View map</a></p>
        </address>
      </div>

      <div class="qo-footer__form" id="QuestFooterContactWrap">
        {%- form 'contact', id: 'QuestFooterContact', novalidate: 'novalidate', class: 'qo-footer__form-el' -%}
          <h2 class="qo-footer__form-title">{{ section.settings.form_heading | default: 'Contact Quest Watersports Today!' }}</h2>
          {%- if form.posted_successfully? -%}
            <p class="qo-footer__msg qo-footer__msg--ok" role="status" tabindex="-1" id="QuestFooterContactStatus">Thanks! We'll be in touch.</p>
          {%- endif -%}
          {%- if form.errors -%}
            <div class="qo-footer__msg qo-footer__msg--err" role="alert" tabindex="-1" id="QuestFooterContactStatus">
              <p>Please fix the following:</p>
              <ul>
                {%- for field in form.errors -%}
                  <li>{{ form.errors.translated_fields[field] | capitalize }} {{ form.errors.messages[field] }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
          <div class="qo-footer__field">
            <label for="QFC-first">First Name*</label>
            <input id="QFC-first" type="text" name="contact[first_name]" autocomplete="given-name" placeholder="First Name*" aria-label="First Name" required value="{{ form.first_name }}">
          </div>
          <div class="qo-footer__field">
            <label for="QFC-last">Last Name*</label>
            <input id="QFC-last" type="text" name="contact[last_name]" autocomplete="family-name" placeholder="Last Name*" aria-label="Last Name" required value="{{ form.last_name }}">
          </div>
          <div class="qo-footer__field">
            <label for="QFC-email">Email*</label>
            <input id="QFC-email" type="email" name="contact[email]" autocomplete="email" placeholder="Email*" aria-label="Email" required value="{{ form.email }}" {% if form.errors contains 'email' %}aria-invalid="true"{% endif %}>
          </div>
          <div class="qo-footer__field">
            <label for="QFC-phone">Phone*</label>
            <input id="QFC-phone" type="tel" name="contact[phone]" autocomplete="tel" placeholder="Phone*" aria-label="Phone" required value="{{ form.phone }}">
          </div>
          <div class="qo-footer__field qo-footer__field--body">
            <label for="QFC-body">Message*</label>
            <textarea id="QFC-body" name="contact[body]" rows="5" placeholder="Message*" aria-label="Message" required>{{ form.body }}</textarea>
          </div>
          <button type="submit" class="qo-footer__send">Send Message</button>
        {%- endform -%}
      </div>
    </div>

    <section class="qo-footer__open" aria-labelledby="QOFooterOpen">
      <h2 class="qo-footer__open-title" id="QOFooterOpen">{{ section.settings.hours_heading | default: 'We are open' }}</h2>
      {%- assign seasons = section.blocks | where: 'type', 'season' -%}
      {%- if seasons.size > 0 -%}
        <div class="qo-footer__tabs" role="tablist" aria-label="Seasonal hours" data-qo-tabs>
          {%- for block in seasons -%}
            <button type="button" role="tab" class="qo-footer__tab" id="QOTab-{{ block.id }}" aria-controls="QOPanel-{{ block.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" tabindex="{% if forloop.first %}0{% else %}-1{% endif %}" data-season="{{ block.settings.key | default: block.settings.title | downcase }}" {{ block.shopify_attributes }}>
              <span class="qo-footer__tab-name">{{ block.settings.title }}</span>
              <span class="qo-footer__tab-dates">{{ block.settings.dates }}</span>
            </button>
          {%- endfor -%}
        </div>
        {%- for block in seasons -%}
          <div class="qo-footer__hours" role="tabpanel" id="QOPanel-{{ block.id }}" aria-labelledby="QOTab-{{ block.id }}" tabindex="0" {% unless forloop.first %}hidden{% endunless %}>
            <div class="qo-footer__cols">
              {%- for n in (1..3) -%}
                {%- assign h_key = 'col' | append: n | append: '_title' -%}
                {%- assign l_key = 'col' | append: n | append: '_lines' -%}
                {%- assign col_title = block.settings[h_key] -%}
                {%- assign col_lines = block.settings[l_key] -%}
                {%- if col_title != blank -%}
                  <div class="qo-footer__col">
                    <h3>{{ col_title }}</h3>
                    <ul>
                      {%- assign lines = col_lines | newline_to_br | split: '<br />' -%}
                      {%- for line in lines -%}
                        {%- assign line = line | strip_newlines | strip -%}
                        {%- if line == blank -%}{%- continue -%}{%- endif -%}
                        {%- if line contains '|' -%}
                          {%- assign parts = line | split: '|' -%}
                          <li><strong>{{ parts[0] | strip }}</strong><span>{{ parts[1] | strip }}</span></li>
                        {%- else -%}
                          <li class="qo-footer__note">{{ line }}</li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </section>
  </div>

  <div class="qo-footer__bar">
    <div class="qo-footer__bar-inner">
      <p class="qo-footer__legal">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | default: 'Quest Watersports' }}. All Rights Reserved.
        <span class="qo-footer__sep" aria-hidden="true">|</span>
        <a href="{{ section.settings.newsletter_url | default: '#QuestFooterContact' }}">Newsletter</a>
        <span class="qo-footer__sep" aria-hidden="true">|</span>
        <a href="{{ shop.privacy_policy.url | default: '/policies/privacy-policy' }}">Privacy Policy</a>
        {%- if shop.terms_of_service.url != blank -%}
          <span class="qo-footer__sep" aria-hidden="true">|</span>
          <a href="{{ shop.terms_of_service.url }}">Terms of Service</a>
        {%- endif -%}
        {%- if shop.refund_policy.url != blank -%}
          <span class="qo-footer__sep" aria-hidden="true">|</span>
          <a href="{{ shop.refund_policy.url }}">Refund Policy</a>
        {%- endif -%}
        <span class="qo-footer__sep" aria-hidden="true">|</span>
        <a href="{{ section.settings.sitemap_url | default: '/sitemap.xml' }}">Sitemap</a>
      </p>
      <ul class="qo-footer__social">
        <li>
          <a href="{{ section.settings.facebook_url | default: 'https://www.facebook.com/QuestWS' }}" target="_blank" rel="noopener" aria-label="Quest Watersports on Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><path fill="currentColor" d="M13.5 21v-8h2.7l.4-3.2h-3.1V7.8c0-.9.3-1.5 1.6-1.5h1.7V3.4c-.3 0-1.3-.1-2.4-.1-2.4 0-4.1 1.5-4.1 4.2v2.3H7.5V13h2.8v8z"/></svg>
          </a>
        </li>
        <li>
          <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/kayakquest' }}" target="_blank" rel="noopener" aria-label="Quest Watersports on Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>

<script src="{{ 'qo-footer.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Quest footer",
  "tag": "div",
  "class": "qo-footer-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Map panel" },
    { "type": "text", "id": "directions_label", "label": "Directions label", "default": "Get Directions" },
    { "type": "text", "id": "directions_url", "label": "Directions link", "default": "https://www.google.com/maps/dir/?api=1&destination=Quest+Watersports,+1800+N+2871st+Rd,+Ottawa,+IL+61350" },
    { "type": "text", "id": "address_line1", "label": "Address line 1", "default": "1851 Old Chicago Rd" },
    { "type": "text", "id": "address_line2", "label": "Address line 2", "default": "Ottawa, IL 61350" },
    { "type": "text", "id": "phone_display", "label": "Phone (displayed)", "default": "815.433.2200" },
    { "type": "text", "id": "phone_tel", "label": "Phone (tel link)", "default": "+18154332200" },
    { "type": "header", "content": "Contact form" },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Contact Quest Watersports Today!" },
    { "type": "header", "content": "Hours" },
    { "type": "text", "id": "hours_heading", "label": "Heading", "default": "We are open" },
    { "type": "header", "content": "Bottom bar" },
    { "type": "text", "id": "newsletter_url", "label": "Newsletter link", "default": "#QuestFooterContact" },
    { "type": "text", "id": "sitemap_url", "label": "Sitemap link", "default": "/sitemap.xml" },
    { "type": "text", "id": "facebook_url", "label": "Facebook URL", "default": "https://www.facebook.com/QuestWS" },
    { "type": "text", "id": "instagram_url", "label": "Instagram URL", "default": "https://www.instagram.com/kayakquest" }
  ],
  "blocks": [
    {
      "type": "season",
      "name": "Season",
      "settings": [
        { "type": "text", "id": "title", "label": "Season name", "default": "Spring" },
        { "type": "select", "id": "key", "label": "Season (for auto-select by date)", "default": "spring", "options": [
          { "value": "spring", "label": "Spring (Apr 1 - Memorial Day)" },
          { "value": "summer", "label": "Summer (Memorial Day - Labor Day)" },
          { "value": "fall", "label": "Fall (Labor Day - Oct 31)" },
          { "value": "winter", "label": "Winter (Nov 1 - March 30)" }
        ] },
        { "type": "text", "id": "dates", "label": "Date range", "default": "April 1 - Memorial Day" },
        { "type": "text", "id": "col1_title", "label": "Column 1 heading", "default": "Spring" },
        { "type": "textarea", "id": "col1_lines", "label": "Column 1 lines (Label|Value per line)", "default": "Tuesday – Saturday:|9:00AM – 5:00PM" },
        { "type": "text", "id": "col2_title", "label": "Column 2 heading", "default": "Service" },
        { "type": "textarea", "id": "col2_lines", "label": "Column 2 lines", "default": "Tuesday – Saturday:|8:00AM – 5:00PM" },
        { "type": "text", "id": "col3_title", "label": "Column 3 heading", "default": "Heritage Harbor Marina" },
        { "type": "textarea", "id": "col3_lines", "label": "Column 3 lines", "default": "Saturday – Sunday:|Weather permitting\nPlease Call Quest: 815-433-2200" }
      ]
    }
  ]
}
{% endschema %}
