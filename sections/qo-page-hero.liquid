{{ 'qo-page-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bg_fallback = 'qo-banner-bg.webp' | asset_url
  assign bg_fallback_m = 'qo-banner-bg-m.webp' | asset_url
  assign nav_links = blank
  assign parent = section.settings.parent_title | strip
  if parent != blank
    for l in linklists['quest-main-menu'].links
      if l.title == parent
        assign nav_links = l.links
      endif
    endfor
  endif
-%}
<section class="qo-hero qo-hero-{{ section.id }}">
  <div class="qo-hero__bg" aria-hidden="true">
    {%- if section.settings.background_image != blank -%}
      <img src="{{ section.settings.background_image | image_url: width: 1600 }}" alt="" width="1600" height="{{ 1600 | divided_by: section.settings.background_image.aspect_ratio | round }}" fetchpriority="high">
    {%- else -%}
      <picture>
        <source media="(max-width: 749px)" srcset="{{ bg_fallback_m }}">
        <img src="{{ bg_fallback }}" alt="" width="1920" height="1080" fetchpriority="high">
      </picture>
    {%- endif -%}
  </div>
  <div class="qo-container qo-hero__inner{% if nav_links == blank or nav_links.size == 0 %} qo-hero__inner--no-nav{% endif %}">
    {%- if nav_links != blank and nav_links.size > 0 -%}
      <nav class="qo-hero__nav" aria-label="{{ parent | escape }}">
        <ul role="list">
          {%- for l in nav_links -%}
            <li><a href="{{ l.url }}"{% if l.current %} aria-current="page"{% endif %}>{{ l.title | escape }}</a></li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    <div class="qo-hero__banner">
      {%- if section.settings.image != blank -%}
        <img
          src="{{ section.settings.image | image_url: width: 1100 }}"
          srcset="{{ section.settings.image | image_url: width: 550 }} 550w, {{ section.settings.image | image_url: width: 800 }} 800w, {{ section.settings.image | image_url: width: 1100 }} 1100w, {{ section.settings.image | image_url: width: 1600 }} 1600w"
          sizes="(min-width: 1200px) 1085px, 100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}"
          fetchpriority="high">
      {%- else -%}
        <div class="qo-hero__banner-fallback">
          {%- if section.settings.heading != blank -%}<p class="qo-hero__heading">{{ section.settings.heading | escape }}</p>{%- endif -%}
          {%- if section.settings.subheading != blank -%}<p class="qo-hero__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page hero + sub-nav",
  "tag": "div",
  "class": "section-qo-page-hero",
  "settings": [
    { "type": "text", "id": "parent_title", "label": "Sub-nav: main menu item title", "info": "Shows the dropdown links of this item in the quest-main-menu (e.g. Paddlesports, Electric Bike, Sailing, Boating). Leave empty for no sub-nav." },
    { "type": "image_picker", "id": "image", "label": "Banner image" },
    { "type": "image_picker", "id": "background_image", "label": "Background photo (optional)", "info": "Defaults to the sunset background." },
    { "type": "text", "id": "heading", "label": "Banner text (used when no banner image)", "default": "Quest Watersports" },
    { "type": "text", "id": "subheading", "label": "Banner sub text" }
  ],
  "presets": [ { "name": "Page hero + sub-nav" } ]
}
{% endschema %}
