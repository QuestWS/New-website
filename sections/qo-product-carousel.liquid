{{ 'qo-product-carousel.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign coll = section.settings.collection
  assign limit = section.settings.products_to_show
-%}
{%- if coll != blank and coll.products_count > 0 -%}
  <section class="qo-carousel qo-carousel--{{ section.settings.style }}" id="QoCarousel-{{ section.id }}" data-qo-carousel>
    {%- if section.settings.style == 'water' -%}
      <div class="qo-carousel__bg" style="background-image:url('{{ 'qo-inventory-bg.webp' | asset_url }}')" aria-hidden="true"></div>
    {%- endif -%}
    <div class="qo-container qo-carousel__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="qo-carousel__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="qo-carousel__tools">
        <a class="qo-carousel__viewall" href="{{ coll.url }}">{{ section.settings.view_all_label | default: 'View All' | escape }}</a>
      </div>
      <div class="qo-carousel__stage">
        <button type="button" class="qo-carousel__arrow qo-carousel__arrow--prev" aria-label="Previous products" data-qo-prev>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 2L4 8l6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <ul class="qo-carousel__track" role="list" data-qo-track tabindex="0" aria-label="{{ section.settings.heading | default: coll.title | escape }}">
          {%- for product in coll.products limit: limit -%}
            {%- assign first_variant = product.selected_or_first_available_variant -%}
            {%- capture qo_buyable -%}{%- render 'qo-buyable', product: product -%}{%- endcapture -%}
            <li class="qo-card">
              <a class="qo-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image -%}
                  <img src="{{ product.featured_image | image_url: width: 400 }}"
                    srcset="{{ product.featured_image | image_url: width: 250 }} 250w, {{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w"
                    sizes="(min-width: 750px) 260px, 70vw"
                    alt="" width="400" height="{{ 400 | divided_by: product.featured_image.aspect_ratio | round }}" loading="lazy">
                {%- else -%}
                  <span class="qo-card__noimg"></span>
                {%- endif -%}
              </a>
              <h3 class="qo-card__title"><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>
              <p class="qo-card__price">
                {%- liquid
                  assign qo_nocall = false
                  if product.tags contains 'make:Hobie'
                    if product.tags contains 'year:2026' or product.tags contains 'year:2027'
                      assign qo_nocall = true
                    endif
                  endif
                -%}
                {%- if product.tags contains 'inventory' and product.price == 0 or product.tags contains 'inventory' and product.metafields.custom.call_for_price.value == true and qo_nocall == false -%}
                  Call for price
                {%- else -%}
                {%- if product.price_varies -%}<span class="qo-card__from">From </span>{%- endif -%}
                {{- product.price | money -}}
                {%- if product.compare_at_price > product.price -%} <s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                {%- endif -%}
              </p>
              {%- if qo_buyable == 'true' and product.variants.size == 1 and first_variant.available -%}
                {%- form 'product', product, class: 'qo-card__form' -%}
                  <input type="hidden" name="id" value="{{ first_variant.id }}">
                  <button type="submit" class="qo-card__bar">Add to cart</button>
                {%- endform -%}
              {%- elsif qo_buyable != 'true' -%}
                <a class="qo-card__bar" href="{{ product.url }}">View Details</a>
              {%- elsif product.available == false -%}
                <a class="qo-card__bar qo-card__bar--muted" href="{{ product.url }}">Sold out</a>
              {%- else -%}
                <a class="qo-card__bar" href="{{ product.url }}">{{ section.settings.options_label | default: 'View details' | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
        <button type="button" class="qo-carousel__arrow qo-carousel__arrow--next" aria-label="Next products" data-qo-next>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6 2l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>
  </section>
  <script src="{{ 'qo-product-carousel.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Product carousel",
  "tag": "div",
  "class": "section-qo-product-carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Parts and Accessories" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 20, "step": 1, "default": 12, "label": "Products to show" },
    { "type": "select", "id": "style", "label": "Background", "options": [ { "value": "navy", "label": "Navy" }, { "value": "water", "label": "Water photo" } ], "default": "navy" },
    { "type": "text", "id": "view_all_label", "label": "View all label", "default": "View All" },
    { "type": "text", "id": "options_label", "label": "Label for products with options", "default": "View details" }
  ],
  "presets": [ { "name": "Product carousel" } ]
}
{% endschema %}
