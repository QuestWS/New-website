{{ 'qo-home-destinations.css' | asset_url | stylesheet_tag }}
<section class="qo-dest" aria-labelledby="QoDest-{{ section.id }}">
  <picture class="qo-dest__bg">
    <source media="(max-width: 450px)" srcset="{{ 'qo-banner-bg-m.webp' | asset_url }}" width="428" height="492">
    <img src="{{ 'qo-banner-bg.webp' | asset_url }}" width="1920" height="1080" alt="" fetchpriority="high" decoding="async">
  </picture>
  <div class="qo-container qo-dest__inner">
    <h1 class="qo-dest__title" id="QoDest-{{ section.id }}"><span>{{ section.settings.eyebrow | escape }}</span> {{ section.settings.heading | escape }}</h1>
    <div class="qo-dest__row">
      {%- for block in section.blocks -%}
        {%- assign fallback = block.settings.fallback_image | default: 'qo-banner-1.webp' -%}
        <article class="qo-dest__card" {{ block.shopify_attributes }}>
          <div class="qo-dest__media">
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 520 | image_tag: width: 260, height: 285, widths: '260, 520', sizes: '(min-width: 750px) 211px, 244px', loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              <img src="{{ fallback | asset_url }}" width="260" height="285" alt="{{ block.settings.title | escape }}" {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
            {%- endif -%}
          </div>
          <div class="qo-dest__panel">
            <h2 class="qo-dest__name">{{ block.settings.title }}</h2>
            <div class="qo-dest__btns">
              {%- for i in (1..3) -%}
                {%- assign lk = 'link_' | append: i -%}
                {%- assign lb = 'label_' | append: i -%}
                {%- assign st = 'style_' | append: i -%}
                {%- if block.settings[lb] != blank and block.settings[lk] != blank -%}
                  <a class="qo-btn{% if block.settings[st] == 'red' %} qo-btn--red{% endif %}" href="{{ block.settings[lk] }}">{{ block.settings[lb] }}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home: destinations",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small italic line", "default": "Choose Your" },
    { "type": "text", "id": "heading", "label": "Heading (H1)", "default": "Destination" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Destination card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "fallback_image", "label": "Fallback theme asset name", "info": "e.g. qo-banner-2.webp" },
        { "type": "text", "id": "title", "label": "Title", "default": "Destination" },
        { "type": "text", "id": "label_1", "label": "Button 1 label" },
        { "type": "url", "id": "link_1", "label": "Button 1 link" },
        { "type": "select", "id": "style_1", "label": "Button 1 style", "default": "yellow", "options": [ { "value": "yellow", "label": "Yellow" }, { "value": "red", "label": "Red" } ] },
        { "type": "text", "id": "label_2", "label": "Button 2 label" },
        { "type": "url", "id": "link_2", "label": "Button 2 link" },
        { "type": "select", "id": "style_2", "label": "Button 2 style", "default": "yellow", "options": [ { "value": "yellow", "label": "Yellow" }, { "value": "red", "label": "Red" } ] },
        { "type": "text", "id": "label_3", "label": "Button 3 label" },
        { "type": "url", "id": "link_3", "label": "Button 3 link" },
        { "type": "select", "id": "style_3", "label": "Button 3 style", "default": "yellow", "options": [ { "value": "yellow", "label": "Yellow" }, { "value": "red", "label": "Red" } ] }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [ { "name": "Home: destinations" } ]
}
{% endschema %}
