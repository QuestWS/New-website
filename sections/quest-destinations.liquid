{{ 'section-quest-destinations.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }
  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="quest-destinations page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <h2 class="quest-destinations__heading {{ section.settings.heading_size }}">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.intro != blank -%}
      <p class="quest-destinations__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}
    <ul class="quest-destinations__grid{% if section.settings.mobile_carousel %} quest-destinations__grid--carousel{% endif %}" role="list">
      {%- for block in section.blocks -%}
        <li class="quest-card" {{ block.shopify_attributes }}>
          <div class="quest-card__media">
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: width: 1100
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 540, 720, 1100',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 85vw',
                  class: 'quest-card__image'
              }}
            {%- else -%}
              <div class="quest-card__placeholder" aria-hidden="true"></div>
            {%- endif -%}
          </div>
          <div class="quest-card__body">
            {%- if block.settings.title != blank -%}
              <h3 class="quest-card__title h3">
                {%- if block.settings.primary_link != blank -%}
                  <a class="quest-card__link" href="{{ block.settings.primary_link }}">{{ block.settings.title | escape }}</a>
                {%- else -%}
                  {{ block.settings.title | escape }}
                {%- endif -%}
              </h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="quest-card__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
            {%- liquid
              assign has_links = false
              if block.settings.link_label_1 != blank and block.settings.link_url_1 != blank
                assign has_links = true
              endif
              if block.settings.link_label_2 != blank and block.settings.link_url_2 != blank
                assign has_links = true
              endif
              if block.settings.link_label_3 != blank and block.settings.link_url_3 != blank
                assign has_links = true
              endif
            -%}
            {%- if has_links -%}
              <ul class="quest-card__links" role="list">
                {%- for i in (1..3) -%}
                  {%- liquid
                    assign label_key = 'link_label_' | append: i
                    assign url_key = 'link_url_' | append: i
                    assign link_label = block.settings[label_key]
                    assign link_url = block.settings[url_key]
                  -%}
                  {%- if link_label != blank and link_url != blank -%}
                    <li><a class="quest-card__sublink" href="{{ link_url }}">{{ link_label | escape }}</a></li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "Quest destinations",
  "tag": "section",
  "class": "section-quest-destinations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Choose Your Destination" },
    { "type": "select", "id": "heading_size", "label": "Heading size", "options": [ { "value": "h2", "label": "Medium" }, { "value": "h1", "label": "Large" } ], "default": "h1" },
    { "type": "text", "id": "intro", "label": "Intro text" },
    { "type": "checkbox", "id": "mobile_carousel", "label": "Swipeable carousel on mobile", "default": false },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Bottom padding", "default": 48 }
  ],
  "blocks": [
    {
      "type": "destination",
      "name": "Destination",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Destination" },
        { "type": "textarea", "id": "text", "label": "Text" },
        { "type": "url", "id": "primary_link", "label": "Main link (title and card)" },
        { "type": "header", "content": "Secondary links" },
        { "type": "text", "id": "link_label_1", "label": "Link 1 label" },
        { "type": "url", "id": "link_url_1", "label": "Link 1" },
        { "type": "text", "id": "link_label_2", "label": "Link 2 label" },
        { "type": "url", "id": "link_url_2", "label": "Link 2" },
        { "type": "text", "id": "link_label_3", "label": "Link 3 label" },
        { "type": "url", "id": "link_url_3", "label": "Link 3" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Quest destinations",
      "blocks": [
        { "type": "destination", "settings": { "title": "Boating", "text": "New and pre-owned boats, plus full-service marine repair and maintenance.", "primary_link": "/pages/boating", "link_label_1": "View Boats", "link_url_1": "/pages/boating", "link_label_2": "Service & Parts", "link_url_2": "/pages/service-and-parts" } },
        { "type": "destination", "settings": { "title": "Quest Express Boat Club", "text": "Unlimited access to a fleet of club boats on an annual membership. No buying, storing or maintaining a boat.", "primary_link": "/pages/boat-club", "link_label_1": "Learn More", "link_url_1": "/pages/boat-club", "link_label_2": "Member Login", "link_url_2": "/pages/member-login", "link_label_3": "Club FAQs", "link_url_3": "/pages/boat-club-faq" } },
        { "type": "destination", "settings": { "title": "Sailing", "text": "Hobie sailboats, parts and accessories.", "primary_link": "/pages/sailing", "link_label_1": "View Sailboats", "link_url_1": "/pages/sailing", "link_label_2": "Parts & Accessories", "link_url_2": "/collections/sailing-parts" } },
        { "type": "destination", "settings": { "title": "Paddlesports", "text": "Hobie kayaks, Old Town, Advanced Elements and stand-up paddleboards.", "primary_link": "/pages/paddlesports", "link_label_1": "Hobie Kayaks", "link_url_1": "/collections/hobie-kayaks", "link_label_2": "Parts & Accessories", "link_url_2": "/collections/kayak-parts", "link_label_3": "Rentals", "link_url_3": "/pages/rentals" } },
        { "type": "destination", "settings": { "title": "Electric Bikes", "text": "eBikes for exploring the I&M Canal Trail and Starved Rock Country.", "primary_link": "/pages/ebikes", "link_label_1": "Shop eBikes", "link_url_1": "/collections/ebikes", "link_label_2": "Parts & Accessories", "link_url_2": "/collections/bike-parts", "link_label_3": "eBike Rentals", "link_url_3": "/pages/ebike-rentals" } },
        { "type": "destination", "settings": { "title": "Rentals", "text": "Paddlesport and eBike rentals for a day on the Illinois River or the canal trail.", "primary_link": "/pages/rentals", "link_label_1": "Kayak & Paddleboard Rentals", "link_url_1": "/pages/rentals", "link_label_2": "eBike Rentals", "link_url_2": "/pages/ebike-rentals" } }
      ]
    }
  ]
}
{% endschema %}
