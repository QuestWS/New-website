{{ 'qo-home-shop.css' | asset_url | stylesheet_tag }}
{%- assign coll = section.settings.collection -%}
{%- if coll != blank and coll.products_count > 0 -%}
<section class="qo-shop" aria-labelledby="QoShop-{{ section.id }}" data-qo-shop>
  <div class="qo-container">
    <div class="qo-shop__head">
      <h2 id="QoShop-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      <div class="qo-shop__arrows">
        <button type="button" class="qo-shop__arrow" data-dir="-1" aria-label="Previous products"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 3 5 9l6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="qo-shop__arrow" data-dir="1" aria-label="Next products"><svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="m7 3 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      </div>
    </div>
    <ul class="qo-shop__track" data-track role="list">
      {%- for product in coll.products limit: section.settings.products_to_show -%}
        {%- assign media = product.featured_media -%}
        <li class="qo-shop__card">
          <a class="qo-shop__img" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if media != blank -%}
              {{ media | image_url: width: 600 | image_tag: width: 300, height: 300, widths: '200, 300, 400, 600', sizes: '(min-width: 990px) 255px, 72vw', loading: 'lazy', alt: media.alt | default: product.title }}
            {%- endif -%}
          </a>
          <div class="qo-shop__body">
            <h3 class="qo-shop__name"><a href="{{ product.url }}">{{ product.title }}</a></h3>
            <p class="qo-shop__price">{%- if product.compare_at_price > product.price -%}<s>{{ product.compare_at_price | money }}</s> {% endif -%}{%- if product.price_varies -%}From {% endif -%}{{ product.price | money }}</p>
          </div>
          {%- if product.available and product.variants.size == 1 -%}
            {%- form 'product', product, class: 'qo-shop__form' -%}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
              <input type="hidden" name="quantity" value="1">
              <button type="submit" class="qo-shop__bar">Add to cart</button>
            {%- endform -%}
          {%- else -%}
            <a class="qo-shop__bar" href="{{ product.url }}">{% if product.available %}View{% else %}Sold out{% endif %}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
    <div class="qo-shop__more"><a class="qo-btn" href="{{ coll.url }}">{{ section.settings.button_label | escape }}</a></div>
  </div>
</section>
<script>
  (function () {
    document.querySelectorAll('[data-qo-shop]').forEach(function (root) {
      var track = root.querySelector('[data-track]');
      root.querySelectorAll('.qo-shop__arrow').forEach(function (b) {
        b.addEventListener('click', function () {
          var card = track.querySelector('.qo-shop__card');
          var step = card ? card.getBoundingClientRect().width + 20 : 280;
          track.scrollBy({ left: step * Number(b.dataset.dir), behavior: 'smooth' });
        });
      });
    });
  })();
</script>
{%- elsif request.design_mode -%}
  <div class="qo-container" style="padding-block:24px">Choose a collection for the Shop Online section.</div>
{%- endif -%}

{% schema %}
{
  "name": "Home: shop online",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop Online" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 4, "max": 16, "step": 1, "default": 8 },
    { "type": "text", "id": "button_label", "label": "View all button label", "default": "View All" }
  ],
  "presets": [ { "name": "Home: shop online" } ]
}
{% endschema %}
